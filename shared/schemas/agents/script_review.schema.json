{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "script_review.schema.json",
  "title": "ScriptReview",
  "type": "object",
  "required": ["verdict", "checks", "feedback_items", "summary"],
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "revise"] },
    "checks": {
      "type": "object",
      "required": ["accuracy", "storytelling", "clarity", "consistency", "duration"],
      "additionalProperties": true,
      "properties": {
        "accuracy": { "type": "boolean" },
        "storytelling": { "type": "boolean" },
        "clarity": { "type": "boolean" },
        "consistency": { "type": "boolean" },
        "duration": { "type": "boolean" }
      }
    },
    "feedback_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "severity", "suggestion"],
        "additionalProperties": false,
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "suggestion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 }
  }
}
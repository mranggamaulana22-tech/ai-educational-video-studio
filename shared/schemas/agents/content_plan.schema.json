{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content_plan.schema.json",
  "title": "ContentPlan",
  "type": "object",
  "required": ["series", "videos"],
  "additionalProperties": false,
  "properties": {
    "series": { "type": "string", "minLength": 1 },
    "videos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["day", "title", "format", "hook", "angle", "topics", "why"],
        "additionalProperties": true,
        "properties": {
          "day": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "format": {
            "type": "string",
            "enum": ["myth_vs_fact", "step_by_step", "analogy", "comparison", "concept_breakdown"]
          },
          "hook": { "type": "string", "minLength": 1 },
          "angle": { "type": "string", "minLength": 1 },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "section_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}